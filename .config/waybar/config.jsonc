{
	"layer": "top",
	"position": "top",
	"margin-top": 8,
	"margin-left": 12,
	"margin-right": 12,
	"spacing": 8,
	"modules-left": [
		"custom/launcher",
		"hyprland/workspaces",
		"hyprland/window"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"pulseaudio",
		"network",
		"temperature",
		"custom/power"
	],
	// ─────────────────────────────────────────
	// Launcher
	// ─────────────────────────────────────────
	"custom/launcher": {
		"format": "󰣇",
		"on-click": "wofi --show drun",
		"tooltip": false
	},
	// ─────────────────────────────────────────
	// Workspaces
	// ─────────────────────────────────────────
	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"active-only": false,
		"on-click": "activate",
		"format": "{icon}",
		"format-icons": {
			"1": "󰮯",
			"2": "󰊠",
			"3": "󰊠",
			"4": "󰊠",
			"5": "󰊠",
			"default": "󰊠"
		},
		"persistent-workspaces": {
			"*": [
				1,
				2,
				3,
				4
			]
		}
	},
	// ─────────────────────────────────────────
	// Ventana activa
	// ─────────────────────────────────────────
	"hyprland/window": {
		"format": "{title}",
		"separate-outputs": true,
		"max-length": 25,
		"rewrite": {
			"^(.*)$": "󱂬 $1"
		}
	},
	// ─────────────────────────────────────────
	// Clock
	// ─────────────────────────────────────────
	"clock": {
		"format": "󰥔  {:%I:%M %p  •  󰃭  %a %d %b}",
		"tooltip-format": "<big>󰃭  {:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
	},
	// ─────────────────────────────────────────
	// Audio
	// ─────────────────────────────────────────
	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"format-muted": "󰝟",
		"format-icons": {
			"default": [
				"󰕿",
				"󰖀",
				"󰕾"
			]
		},
		"on-click": "pavucontrol",
		"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
		"scroll-step": 5
	},
	// ─────────────────────────────────────────
	// Network
	// ─────────────────────────────────────────
	"network": {
		"format-wifi": "󰤨  {essid}",
		"format-ethernet": "󰤨  Wi-Fi",
		"format-disconnected": "󰤮  Offline",
		"tooltip-format": "󰌘 {ifname}\n󰩟 {ipaddr}",
		"on-click": "nm-connection-editor"
	},
	// ─────────────────────────────────────────
	// Temperature
	// ─────────────────────────────────────────
	"temperature": {
		"critical-threshold": 80,
		"format": "󰍛  {temperatureC}°C",
		"tooltip-format": "󰍛  CPU: {temperatureC}°C"
	},
	// ─────────────────────────────────────────
	// Power
	// ─────────────────────────────────────────
	"custom/power": {
		"format": "󰐥",
		"on-click": "wlogout",
		"tooltip": false
	}
}
