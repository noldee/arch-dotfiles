{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "sixel",
		"width": 18,
		"height": 9,
		"padding": {
			"top": 1,
			"right": 2
		}
	},
	"display": {
		"separator": " 󰄾 ",
		"color": {
			"keys": "cyan"
		}
	},
	"modules": [
		{
			"type": "title",
			"format": "  \u001b[1m\u001b[34m{1}\u001b[0m@\u001b[1m\u001b[35m{2}\u001b[0m"
		},
		"break",
		{
			"type": "os",
			"key": "󰣇 OS",
			"keyColor": "cyan"
		},
		{
			"type": "kernel",
			"key": "󰌽 Kernel",
			"keyColor": "blue"
		},
		{
			"type": "uptime",
			"key": "󰅐 Uptime",
			"keyColor": "green"
		},
		{
			"type": "packages",
			"key": "󰏖 Packages",
			"keyColor": "yellow"
		},
		{
			"type": "shell",
			"key": "󰞷 Shell",
			"keyColor": "magenta"
		},
		{
			"type": "wm",
			"key": " WM",
			"keyColor": "cyan"
		},
		{
			"type": "cpu",
			"key": "󰻠 CPU",
			"keyColor": "red",
			"format": "{1}"
		},
		{
			"type": "gpu",
			"key": "󰢮 GPU",
			"keyColor": "red",
			"format": "Intel HD Graphics 2500"
		},
		{
			"type": "memory",
			"key": "󰑭 RAM",
			"keyColor": "yellow"
		},
		"break",
		{
			"type": "colors",
			"symbol": "circle"
		}
	]
}
