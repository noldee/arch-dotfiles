{
	"layer": "top",
	"position": "top",
	"margin-top": 8,
	"margin-left": 12,
	"margin-right": 12,
	"spacing": 8,
	"modules-left": [
		"custom/launcher",
		"hyprland/workspaces"
	],
	"modules-center": [
		"hyprland/window"
	],
	"modules-right": [
		"pulseaudio",
		"network",
		"temperature",
		"clock",
		"custom/power"
	],
	// ─────────────────────────────────────
	// Launcher
	// ─────────────────────────────────────
	"custom/launcher": {
		"format": "󰣇",
		"on-click": "wofi --show drun",
		"tooltip": false
	},
	// ─────────────────────────────────────
	// Workspaces
	// ─────────────────────────────────────
	"hyprland/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"active-only": false,
		"on-click": "activate",
		"format": "{name}",
		"persistent-workspaces": {
			"*": [
				1,
				2
			]
		}
	},
	// ─────────────────────────────────────
	// Active window
	// ─────────────────────────────────────
	"hyprland/window": {
		"format": "{title}",
		"max-length": 45,
		"rewrite": {
			"": "Desktop"
		},
		"separate-outputs": true
	},
	// ─────────────────────────────────────
	// Audio
	// ─────────────────────────────────────
	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"format-muted": "󰝟  Muted",
		"format-icons": {
			"default": [
				"󰕿",
				"󰖀",
				"󰕾"
			]
		},
		"scroll-step": 5,
		"on-click": "pavucontrol",
		"tooltip-format": "{desc}"
	},
	// ─────────────────────────────────────
	// Network
	// ─────────────────────────────────────
	"network": {
		"format-wifi": "󰤨  {essid}",
		"format-ethernet": "󰈀  Ethernet",
		"format-disconnected": "󰤮  Offline",
		"tooltip-format": "{ifname}\n{ipaddr}",
		"on-click": "nm-connection-editor"
	},
	// ─────────────────────────────────────
	// Temperature
	// ─────────────────────────────────────
	"temperature": {
		"critical-threshold": 80,
		"format": "󰔏  {temperatureC}°C",
		"tooltip-format": "CPU: {temperatureC}°C"
	},
	// ─────────────────────────────────────
	// Clock
	// ─────────────────────────────────────
	"clock": {
		"format": "󰥔  {:%H:%M}",
		"format-alt": "󰃭  {:%a %d %b %Y}",
		"tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
	},
	// ─────────────────────────────────────
	// Power
	// ─────────────────────────────────────
	"custom/power": {
		"format": "󰐥",
		"on-click": "wlogout",
		"tooltip": false
	}
}
