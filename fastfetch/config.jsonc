{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "auto",
		"source": "/home/noldee/.config/fastfetch/arch.txt"
	},
	"display": {
		"separator": " ── ",
		"key": {
			"width": 12
		}
	},
	"modules": [
		"title",
		"separator",
		{
			"type": "custom",
			"format": "┌────────────────── Hardware ──────────────────┐"
		},
		"os",
		"kernel",
		"uptime",
		"cpu",
		{
			"type": "gpu",
			"key": "GPU",
			"format": "Intel HD Graphics"
		},
		"memory",
		"disk",
		{
			"type": "custom",
			"format": "└──────────────────────────────────────────────┘"
		},
		{
			"type": "custom",
			"format": "┌────────────────── Software ──────────────────┐"
		},
		"packages",
		"shell",
		"display",
		"wm",
		"terminal",
		"locale",
		{
			"type": "custom",
			"format": "└──────────────────────────────────────────────┘"
		},
		"colors"
	]
}
